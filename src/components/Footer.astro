---
import { SITE } from '../site';
const year = new Date().getFullYear();
---

<footer class="wrap site-footer">
  <!-- Cầu Rồng: four arches and the rising head, drawn as one line -->
  <svg class="dragon" viewBox="0 0 320 48" aria-hidden="true">
    <path
      d="M4 40 H316"
      stroke="currentColor"
      stroke-width="1"
      opacity="0.35"
    ></path>
    <path
      d="M10 40 c4-6 8-8 12-6 C30 6 52 6 60 40 C68 6 90 6 98 40 C106 6 128 6 136 40 C144 6 166 6 174 40 C182 10 200 6 212 18 c6 6 12 4 16-2 l6-4 l4 3 l-5 4"
      fill="none"
      stroke="currentColor"
      stroke-width="1.1"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </svg>
  <div class="row">
    <p>© {year} {SITE.author} · Viết từ Đà Nẵng</p>
    <p class="links">
      <a href="/rss.xml">RSS</a>
      <a href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 96px;
    padding-bottom: calc(40px + env(safe-area-inset-bottom, 0px));
    color: var(--faint);
    font-size: 13px;
  }
  .dragon {
    display: block;
    width: min(320px, 100%);
    height: auto;
    color: var(--accent);
    margin-bottom: 18px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    border-top: 1px solid var(--line);
    padding-top: 18px;
  }
  p { margin: 0; }
  .links { display: flex; gap: 18px; }
  a { text-decoration: none; }
</style>
