---
import { t, type Lang } from '../i18n';

interface Props {
  date: Date;
  lang?: Lang;
  short?: boolean;
}

const { date, lang = 'vi', short = false } = Astro.props;
const locale = t(lang).dateLocale;
// e.g. "14 tháng 11, 2026" / "November 14, 2026", or "14/11" / "Nov 14" in lists
const text = short
  ? date.toLocaleDateString(locale, lang === 'vi' ? { day: '2-digit', month: '2-digit' } : { day: 'numeric', month: 'short' })
  : date.toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric' });
---

<time datetime={date.toISOString()}>{text}</time>
