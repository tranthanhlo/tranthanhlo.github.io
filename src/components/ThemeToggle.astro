<button class="theme-toggle" type="button" aria-label="Đổi giao diện sáng/tối" title="Đổi giao diện sáng/tối">
  <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
    <path d="M12 2.5v2.2M12 19.3v2.2M4.5 12H2.3M21.7 12h-2.2M5.6 5.6l1.5 1.5M16.9 16.9l1.5 1.5M5.6 18.4l1.5-1.5M16.9 7.1l1.5-1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
  </svg>
  <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path d="M19.5 14.6A8 8 0 0 1 9.4 4.5a8 8 0 1 0 10.1 10.1Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: none;
    color: var(--soft);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .theme-toggle:hover { color: var(--accent); border-color: var(--accent); }
  .moon { display: none; }
  :global(:root[data-theme='dark']) .sun { display: none; }
  :global(:root[data-theme='dark']) .moon { display: block; }
</style>
