---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPosts, tagSlug } from '../site';
import { otherLang, paths, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const posts = await getPosts(lang);
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))];
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort((a, b) => a.localeCompare(b, lang));
---

<BaseLayout title={ui.postsTitle} description={ui.postsDescription} lang={lang} alt={{ href: paths(otherLang(lang)).blog, exact: true }}>
  <div class="wrap">
    <h1>{ui.postsTitle}</h1>
    <p class="intro">{posts.length ? ui.postsCount(posts.length) : ui.noPosts}</p>

    {
      tags.length > 0 && (
        <p class="tags">
          {tags.map((tag) => (
            <a href={paths(lang).tag(tagSlug(tag))}>#{tag}</a>
          ))}
        </p>
      )
    }

    {
      years.map((year) => (
        <section>
          <h2>{year}</h2>
          <PostList posts={posts.filter((p) => p.data.date.getFullYear() === year)} lang={lang} shortDates />
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  h1 { font-size: clamp(42px, 8vw, 60px); margin: 32px 0 6px; }
  .intro { margin: 0 0 12px; color: var(--soft); }
  .tags { display: flex; flex-wrap: wrap; gap: 0 18px; margin: 0; font-size: 14px; }
  .tags a { display: inline-flex; align-items: center; min-height: 44px; color: var(--accent); text-decoration: none; }
  section { margin-top: 40px; }
  h2 {
    font-size: 15px;
    font-family: var(--sans);
    font-weight: 400;
    letter-spacing: 0.2em;
    color: var(--faint);
    margin: 0 0 22px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }
</style>
