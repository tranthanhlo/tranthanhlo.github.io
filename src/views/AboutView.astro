---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site';
import { otherLang, paths, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const rss = paths(lang).rss;
---

<BaseLayout title={ui.aboutTitle} description={ui.aboutDescription} lang={lang} alt={{ href: paths(otherLang(lang)).about, exact: true }}>
  <article class="wrap">
    <p class="eyebrow">{ui.aboutTitle}</p>
    <h1>Trần Thanh Lộ</h1>

    {
      lang === 'vi' ? (
        <div class="prose">
          <p>
            Tôi sống và làm việc ở Đà Nẵng. Công việc hằng ngày của tôi là viết phần mềm cho ngành xây dựng: plugin và
            công cụ tự động hóa cho Revit và ArchiCAD, bằng C# và C++. Hiện tôi làm BIM/CAD Software Developer tại Prima
            Solutions, và đang tìm hiểu thêm AutoCAD, Tekla.
          </p>
          <p>Tôi học ở Đại học Bách khoa, Đại học Đà Nẵng.</p>

          {/* TODO: kể thêm về bản thân ngoài công việc: sở thích, điều bạn quan tâm, vì sao lập blog này. */}

          <h2>Blog này</h2>
          <p>
            Không có lịch đăng, không có chủ đề cố định. Có bài về công việc, có bài chẳng liên quan gì tới công việc cả.
            Nếu muốn theo dõi, bạn có thể dùng <a href={rss}>RSS</a>.
          </p>

          <h2>Liên lạc</h2>
          <p>
            Cách nhanh nhất là nhắn cho tôi qua{' '}
            <a href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn</a>.
          </p>
        </div>
      ) : (
        <div class="prose">
          <p>
            I live and work in Da Nang, Vietnam. My day job is writing software for the construction industry: plugins and
            automation tools for Revit and ArchiCAD, in C# and C++. I currently work as a BIM/CAD Software Developer at
            Prima Solutions, and I’m learning AutoCAD and Tekla on the side.
          </p>
          <p>I studied at the University of Science and Technology – The University of Da Nang.</p>

          {/* TODO: translate whatever you add about yourself on the Vietnamese page. */}

          <h2>This blog</h2>
          <p>
            There’s no schedule and no fixed topic. Some posts are about work, some have nothing to do with it. Most posts
            are written in Vietnamese first; the ones translated into English show up here. To follow along, use{' '}
            <a href={rss}>RSS</a>.
          </p>

          <h2>Get in touch</h2>
          <p>
            The quickest way to reach me is a message on{' '}
            <a href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn</a>.
          </p>
        </div>
      )
    }
  </article>
</BaseLayout>

<style>
  .eyebrow { margin-top: 32px; }
  h1 { font-size: clamp(42px, 8vw, 60px); margin: 8px 0 32px; }
</style>
