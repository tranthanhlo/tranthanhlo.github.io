---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../site';
import { paths, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const p = paths(lang);
const posts = (await getPosts(lang)).slice(0, 5);
---

<BaseLayout lang={lang}>
  <div class="wrap">
    <section class="hello">
      <p class="eyebrow">{ui.homeEyebrow}</p>
      <h1>{ui.homeHello}<br />{ui.homeIam} <em>{ui.homeName}</em>.</h1>
      <p class="about">{ui.homeAbout}</p>
      <p class="more"><a href={p.about}>{ui.homeMore}</a></p>
    </section>

    <section>
      <h2>{ui.latest}</h2>
      {posts.length ? <PostList posts={posts} lang={lang} /> : <p class="empty">{ui.noPosts}</p>}
      {posts.length > 0 && <p class="more"><a href={p.blog}>{ui.allPosts}</a></p>}
    </section>
  </div>
</BaseLayout>

<style>
  .hello { margin: 40px 0 88px; }
  h1 {
    margin: 14px 0 22px;
    font-size: clamp(52px, 11vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.01em;
  }
  h1 em { color: var(--accent); }
  .about {
    margin: 0;
    max-width: 34em;
    font-size: 18px;
    color: var(--soft);
  }
  .more { margin: 10px 0 0; font-size: 15px; }
  /* 44px tall tap area */
  .more a { display: inline-flex; align-items: center; min-height: 44px; color: var(--accent); text-decoration: none; }
  h2 {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 28px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }
  .empty { color: var(--soft); }
</style>
