---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { readingTime, tagSlug, type Post } from '../site';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  prev?: Post;
  next?: Post;
}

const { post, headings, prev, next } = Astro.props;
const { title, description, date, updated, tags, cover, coverAlt } = post.data;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={title} description={description}>
  <article class="wrap">
    <header class="post-head">
      <p class="eyebrow">
        <FormattedDate date={date} /> · {readingTime(post.body)} phút đọc
        {updated && <span> · cập nhật <FormattedDate date={updated} /></span>}
      </p>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
    </header>

    {cover && <Image class="cover" src={cover} alt={coverAlt ?? ''} widths={[680, 1360]} sizes="(max-width: 728px) 100vw, 680px" />}

    {
      toc.length >= 3 && (
        <details class="toc">
          <summary>Trong bài này</summary>
          <ol>
            {toc.map((h) => (
              <li class={`d${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    <div class="prose">
      <slot />
    </div>

    {
      tags.length > 0 && (
        <p class="tags">
          {tags.map((t) => (
            <a href={`/the/${tagSlug(t)}`}>#{t}</a>
          ))}
        </p>
      )
    }

    {
      (prev || next) && (
        <nav class="pager" aria-label="Bài khác">
          {prev ? (
            <a class="older" href={`/blog/${prev.id}`}>
              <span class="eyebrow">Bài trước</span>
              {prev.data.title}
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a class="newer" href={`/blog/${next.id}`}>
              <span class="eyebrow">Bài sau</span>
              {next.data.title}
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .post-head { margin: 32px 0 36px; }
  h1 {
    margin: 10px 0 14px;
    font-size: clamp(38px, 7vw, 56px);
    line-height: 1.05;
  }
  .lead {
    margin: 0;
    font-family: var(--display);
    font-style: italic;
    font-size: 22px;
    line-height: 1.45;
    color: var(--soft);
  }
  .cover {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    margin-bottom: 36px;
  }
  .toc {
    margin: 0 0 36px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }
  .toc summary {
    cursor: pointer;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .toc ol { margin: 10px 0 0; padding-left: 1.2em; }
  .toc .d3 { margin-left: 1em; list-style: circle; }
  .toc a { text-decoration: none; color: var(--soft); }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 48px 0 0;
    font-size: 14px;
  }
  .tags a { color: var(--accent); text-decoration: none; }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    text-decoration: none;
    font-family: var(--display);
    font-size: 20px;
    line-height: 1.3;
  }
  .newer { text-align: right; grid-column: 2; }
  @media (max-width: 520px) {
    .pager { grid-template-columns: 1fr; }
    .newer { grid-column: 1; text-align: left; }
  }
</style>
