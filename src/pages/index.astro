---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../site';

const posts = (await getPosts()).slice(0, 5);
---

<BaseLayout>
  <div class="wrap">
    <section class="hello">
      <p class="eyebrow">Đà Nẵng · Việt Nam</p>
      <h1>Xin chào,<br />tôi là <em>Lộ</em>.</h1>
      <p class="about">
        Tôi viết phần mềm cho ngành xây dựng, ngày ngày làm việc với Revit và ArchiCAD. Đây là góc nhỏ để tôi ghi lại
        những điều mình nghĩ, mình học và mình đi qua.
      </p>
      <p class="more"><a href="/ve-toi">Đọc thêm về tôi →</a></p>
    </section>

    <section>
      <h2>Bài viết mới</h2>
      {posts.length ? <PostList posts={posts} /> : <p class="empty">Chưa có bài nào. Bài đầu tiên sắp lên.</p>}
      {posts.length > 0 && <p class="more"><a href="/blog">Tất cả bài viết →</a></p>}
    </section>
  </div>
</BaseLayout>

<style>
  .hello { margin: 40px 0 88px; }
  h1 {
    margin: 14px 0 22px;
    font-size: clamp(52px, 11vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.01em;
  }
  h1 em { color: var(--accent); }
  .about {
    margin: 0;
    max-width: 34em;
    font-size: 18px;
    color: var(--soft);
  }
  .more { margin: 22px 0 0; font-size: 15px; }
  .more a { color: var(--accent); text-decoration: none; }
  h2 {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 28px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }
  .empty { color: var(--soft); }
</style>
