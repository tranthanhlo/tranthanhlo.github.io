---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, tagSlug } from '../../site';

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))];
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort((a, b) => a.localeCompare(b, 'vi'));
---

<BaseLayout title="Bài viết" description="Tất cả bài viết trên blog của Trần Thanh Lộ.">
  <div class="wrap">
    <h1>Bài viết</h1>
    <p class="intro">{posts.length} bài, mới nhất ở trên cùng.</p>

    {
      tags.length > 0 && (
        <p class="tags">
          {tags.map((t) => (
            <a href={`/the/${tagSlug(t)}`}>#{t}</a>
          ))}
        </p>
      )
    }

    {
      years.map((year) => (
        <section>
          <h2>{year}</h2>
          <PostList posts={posts.filter((p) => p.data.date.getFullYear() === year)} shortDates />
        </section>
      ))
    }

    {posts.length === 0 && <p class="intro">Chưa có bài nào. Bài đầu tiên sắp lên.</p>}
  </div>
</BaseLayout>

<style>
  h1 { font-size: clamp(42px, 8vw, 60px); margin: 32px 0 6px; }
  .intro { margin: 0 0 20px; color: var(--soft); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 0 0 8px; font-size: 14px; }
  .tags a { color: var(--accent); text-decoration: none; }
  section { margin-top: 48px; }
  h2 {
    font-size: 15px;
    font-family: var(--sans);
    font-weight: 400;
    letter-spacing: 0.2em;
    color: var(--faint);
    margin: 0 0 22px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }
</style>
