# Copy to .env.local for local work. Production values live in Vercel's Environment Variables.

# Database. Leave empty locally to use the embedded PGlite database in .data/
DATABASE_URL=

# Auth.js
# Only when running `next start` outside Vercel: AUTH_TRUST_HOST=true
AUTH_SECRET=            # openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated Google emails allowed into /admin
ADMIN_EMAILS=
# Local only: adds "dev login" buttons. Ignored when NODE_ENV=production
DEV_LOGIN=

# Public address of the site (used in emails, sitemap and RSS)
SITE_URL=http://localhost:3000

# Images uploaded from /admin (Vercel Blob). Locally, files go to public/uploads
BLOB_READ_WRITE_TOKEN=

# Email to followers (Resend)
RESEND_API_KEY=
EMAIL_FROM=
